#include <stdio.h>
#include<math.h>

int main() {
    int x;
    printf("number : ");
    scanf("%i",&x);
    int temp = x,rem=0,pos=0;
    while(temp!=0){
        int rev = temp%10;
        rem=rem+rev*pow(2,pos);
        pos++;
        temp=temp/10;
    }
    printf("%i",rem);
    
    

    return 0;
}
